# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
ALPHA_VANTAGE_API_KEY=


# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str / comma-separated list), so
# "true"/"3"/"bf16,fp8" all work as expected.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# --- Model / provider ---------------------------------------------------
# Default: openai/gpt-5.6-luna via OpenRouter (2026-08-31). Chosen because
# it is served ONLY by first-party endpoints (OpenAI / Azure / Bedrock),
# which removes the provider lottery at the source. The previous model,
# deepseek-v4-flash-0731, is served by 29 independent upstreams of which 8
# cannot enforce a JSON Schema -- the cause of the empty Research Manager /
# Portfolio Manager reports on 2026-08-29..30. See the provider-routing
# block in tradingagents/default_config.py.
#
# A) Back to the open-weight model, still through OpenRouter. BOTH routing
#    filters must be repopulated at the same time or the fp4 and
#    schema-incapable hosts come back with it.
#TRADINGAGENTS_DEEP_THINK_LLM=deepseek/deepseek-v4-flash-0731
#TRADINGAGENTS_QUICK_THINK_LLM=deepseek/deepseek-v4-flash-0731
#TRADINGAGENTS_OPENROUTER_QUANTIZATIONS=bf16,fp8
#TRADINGAGENTS_OPENROUTER_ONLY_PROVIDERS=openinference,akashml,deepinfra,morph,parasail,mancer2,nextbit
#TRADINGAGENTS_OPENROUTER_IGNORE_PROVIDERS=
#
# B) Off OpenRouter entirely, to DeepSeek's own API (pre-2026-08-26
#    behaviour) -- one implementation, no routing lottery. Needs no git
#    revert: reverting the routing commits would leave you on OpenRouter
#    with the ORIGINAL unfiltered routing, the configuration that broke.
#TRADINGAGENTS_LLM_PROVIDER=deepseek
#TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4-flash
#TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4-flash

# --- OpenRouter routing controls (only used when provider=openrouter) ---
# Comma-separated. Empty string disables that filter. The quantization and
# only-provider filters are EMPTY by default: both are fatal for a
# first-party model (all gpt-5.6-luna endpoints report quantization
# "unknown", and the allowlist names DeepSeek hosts) -- each returns a 404
# with no endpoints matched.
#TRADINGAGENTS_OPENROUTER_IGNORE_PROVIDERS=amazon-bedrock
#TRADINGAGENTS_OPENROUTER_QUANTIZATIONS=
#TRADINGAGENTS_OPENROUTER_ONLY_PROVIDERS=
# Reasoning tokens bill against the completion cap, so this needs headroom:
# a measured call spent 87% of its completion budget on reasoning alone.
#TRADINGAGENTS_OPENROUTER_MAX_COMPLETION_TOKENS=32768
# OpenRouter's :exacto variant. Off by default -- measured 2026-08-31 it
# routed to a provider with no schema support at all, and was ~3x slower.
#TRADINGAGENTS_OPENROUTER_EXACTO=true

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
FINNHUB_API_KEY=

# Raised for local manual testing — see api/settings.py for defaults (10/day per IP).
#TRADINGAGENTS_API_MAX_RUNS_PER_IP_PER_DAY=999999

# JWT secret for signing and verifying tokens (Task 1 of auth-rbac plan).
# Change this before deployment. Must be IDENTICAL to NEXTAUTH_SECRET below --
# one shared secret signs the token on the frontend and verifies it on the
# backend. Required, and must be at least 32 characters (api/settings.py
# fails closed on empty/short values) -- generate one with:
#   openssl rand -base64 32
TRADINGAGENTS_API_JWT_SECRET=

# --- Auth (Phase 1) -----------------------------------------------------
# Google OAuth app credentials (console.cloud.google.com -> Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be IDENTICAL to TRADINGAGENTS_API_JWT_SECRET above -- one shared
# secret signs the token on the frontend and verifies it on the backend.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
