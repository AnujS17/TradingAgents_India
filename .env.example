# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
ALPHA_VANTAGE_API_KEY=


# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"ORCL/"3" work as expected.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
FINNHUB_API_KEY=

# Raised for local manual testing — see api/settings.py for defaults (10/day per IP).
#TRADINGAGENTS_API_MAX_RUNS_PER_IP_PER_DAY=999999

# JWT secret for signing and verifying tokens (Task 1 of auth-rbac plan).
# Change this before deployment. Must be IDENTICAL to NEXTAUTH_SECRET below --
# one shared secret signs the token on the frontend and verifies it on the
# backend.
TRADINGAGENTS_API_JWT_SECRET=

# --- Auth (Phase 1) -----------------------------------------------------
# Google OAuth app credentials (console.cloud.google.com -> Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be IDENTICAL to TRADINGAGENTS_API_JWT_SECRET above -- one shared
# secret signs the token on the frontend and verifies it on the backend.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
