  "components": {
    "schemas": {
      "AnalysisProfile": {
        "type": "string",
        "enum": [
          "fast",
          "detailed"
        ],
        "title": "AnalysisProfile",
        "description": "Maps to the engine's config profiles.\n\n``fast`` is get_fast_config(): analysts run concurrently, 1 debate round,\nbalanced report length \u2014 and it fetches exactly the same data as\n``detailed``. See tradingagents/default_config.py."
      },
      "AnalysisRequest": {
        "properties": {
          "ticker": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Ticker",
            "description": "NSE/BSE symbol. A bare name like 'RELIANCE' is resolved to 'RELIANCE.NS' by the engine.",
            "examples": [
              "SIEMENS.NS",
              "RELIANCE"
            ]
          },
          "analysis_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analysis Date",
            "description": "Defaults to today. Also the cache key: a repeat request for the same ticker and date returns the existing run instead of spending a new one."
          },
          "profile": {
            "$ref": "#/components/schemas/AnalysisProfile",
            "default": "fast"
          },
          "force": {
            "type": "boolean",
            "title": "Force",
            "description": "Run a fresh analysis even when one already exists for this ticker and date. The existing run is kept \u2014 results accumulate rather than being overwritten, so they can be compared.",
            "default": false
          },
          "refresh_data": {
            "type": "boolean",
            "title": "Refresh Data",
            "description": "Also re-fetch news, filings and social data instead of replaying the day's snapshot. Implies force. Use when something has actually happened since the last run; leave false to re-reason over identical inputs.",
            "default": false
          },
          "time_horizon": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Time Horizon",
            "description": "Optional investor holding-period guidance for the Portfolio Manager, e.g. '3-6 months'. Steers how the rating and price target are framed; does not change what data the analysts see, and the Portfolio Manager will say so rather than force a verdict if the evidence points to a different horizon. Implies force, so a request with a horizon never silently reuses a run cached for a different (or no) horizon.",
            "examples": [
              "3-6 months"
            ]
          }
        },
        "type": "object",
        "required": [
          "ticker"
        ],
        "title": "AnalysisRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "database": {
            "type": "string",
            "title": "Database"
          },
          "queue": {
            "type": "string",
            "title": "Queue"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "database",
          "queue"
        ],
        "title": "HealthResponse"
      },
      "NewsSource": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
