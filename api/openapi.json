    "/runs/{run_id}/stream": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Stream Run",
        "description": "Server-Sent Events: token-level live view of an in-progress run.\n\nHonors Last-Event-ID (sent automatically by a reconnecting browser\nEventSource) so a refresh mid-run resumes rather than replaying from\nthe start. Polls run_events via the same WAL-mode SQLite pattern\napi/db.py already documents for concurrent reader/writer access.\n\nRegistered ABOVE /runs/{ticker}/{analysis_date} on purpose: both are\ntwo-segment paths under /runs, and FastAPI matches route order, so this\none must come first or every \"stream\" would be swallowed as a bogus\nanalysis_date and 422 instead of streaming.",
        "operationId": "stream_run_runs__run_id__stream_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/export.pdf": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Export Run Pdf",
        "description": "A one-page-plus PDF: the verdict card's fields, then every available\nreport grouped the same way ReportsRecord.tsx groups them on screen.\n\n404, not an empty/partial file, for a run with nothing to export yet --\nsame reasoning as POST /runs/{id}/resume's 404 for a run that hasn't\nfailed: better to fail loudly than hand back a file that looks legitimate\nbut is missing the one thing (a verdict) the export exists to capture.\n\nRegistered here, above /runs/{ticker}/{analysis_date}, for the same\nreason stream_run is (see its docstring): both are two-segment GET\npaths under /runs, and route order decides which one FastAPI tries\nfirst.",
        "operationId": "export_run_pdf_runs__run_id__export_pdf_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
