# Backend secrets for the Docker Compose deployment (api + worker + caddy
# services — see docker-compose.yml's `x-backend` anchor and `caddy`
# service). Copy to .env.production on the VM and fill it in; that exact
# filename is what docker-compose.yml's `env_file:` entries point at.
#
# IMPORTANT: this file is read two different ways, and both matter:
#   1. `env_file: [.env.production]` in docker-compose.yml injects every
#      line below into the api/worker/caddy containers at runtime.
#   2. Compose ALSO substitutes ${DOMAIN} and ${NEXT_PUBLIC_API_BASE_URL}
#      *inside docker-compose.yml itself* (the caddy service's environment:
#      block, and the web service's build.args:) — and that substitution
#      only reads Compose's own "project .env" (a file literally named
#      .env in the same directory) or shell vars, NEVER an `env_file:`
#      entry. Since this file is deliberately named .env.production (not
#      .env, to keep it visually distinct from a dev checkout's .env), you
#      MUST pass --env-file .env.production on every docker compose
#      command, or DOMAIN/NEXT_PUBLIC_API_BASE_URL silently substitute as
#      empty strings. See DEPLOY.md for the exact commands.

# --- Domain --------------------------------------------------------------
# What Caddy requests a Let's Encrypt certificate for (Caddyfile). Must be
# something DNS actually resolves to this VM's public IP — Caddy cannot
# issue a certificate for a bare IP address. If you don't own a domain yet,
# use a free sslip.io address that embeds the VM's IP (see DEPLOY.md):
#   DOMAIN=203-0-113-10.sslip.io
DOMAIN=

# Public URL the BROWSER calls for every API request except the SSE stream
# proxy (Caddyfile routes /backend/* to the api container) — write out
# DOMAIN's actual value here again, with /backend appended. Deliberately
# NOT `https://${DOMAIN}/backend`: env_file values are not shell-expanded
# by Compose, so a reference to another variable in this same file would
# be baked into the client JS bundle as that literal, un-substituted
# string. This is also passed to the web service's build.args
# (docker-compose.yml), so it gets baked in at image-build time; changing
# it later requires `docker compose build web` again, not just a restart.
NEXT_PUBLIC_API_BASE_URL=https://REPLACE-WITH-YOUR-DOMAIN/backend

# --- LLM provider ----------------------------------------------------------
# Set the key for whichever provider TRADINGAGENTS_LLM_PROVIDER below
# selects. DEFAULT_CONFIG's own default (tradingagents/default_config.py)
# is openai/gpt-5.6-luna via OpenRouter, chosen because it is served only
# by first-party endpoints — no routing lottery. Leave the override lines
# below commented to use that default; only OPENROUTER_API_KEY is then
# required.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Engine configuration (PINNED, do not leave to the code default) ----
# DEFAULT_CONFIG ships OpenRouter/gpt-5.6-luna. Production deliberately
# runs DeepSeek's own API instead: one implementation, no provider lottery,
# and it is the configuration every quality measurement in
# QUALITY_BASELINE_ITC.md was taken on. Set DEEPSEEK_API_KEY above.
TRADINGAGENTS_LLM_PROVIDER=deepseek
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4-flash
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4-flash

# Debate depth. 1 round is the cost/latency choice: ~12 LLM calls and
# ~280s per run, against ~14 calls and ~400s at 2 rounds (measured,
# ITC.NS). The trade is real and documented -- at 1 round the bull never
# answers the bear, so an unsupported bull claim reaches the Research
# Manager unchallenged. Raise to 2 when per-run cost matters less than
# verdict quality.
#
# These reach the fast profile (the API's default) only because
# get_fast_config() no longer re-hardcodes them -- see the note there.
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1

# Resume a crashed run from its last completed node instead of losing 4-14
# minutes of work. Costs a small SQLite file per ticker under the cache dir.
TRADINGAGENTS_CHECKPOINT_ENABLED=true

# --- Data freshness -----------------------------------------------------
# ON by default; listed so it is visible rather than implicit. Off means
# load_ohlcv reuses the day's cache file unconditionally -- the behaviour
# behind two stale-price incidents where a run recommended an entry that
# was never fillable. Leave enabled.
#TRADINGAGENTS_OHLCV_CACHE_FRESHNESS_CHECK=true
#TRADINGAGENTS_OHLCV_CACHE_RECHECK_SECONDS=1800

# Multiplier on the per-agent word budgets under the "balanced" report
# style. 4.0 is the default; lowering it buys wall-clock at a measured
# cost in analysis depth (the compression falls almost entirely on the
# reasoning agents, not the data-reporting ones).
#TRADINGAGENTS_BALANCED_WORD_SCALE=4.0

# How many runs api.worker executes concurrently in one process. 1 is the
# default and is right for a single free-tier VM: every run is LLM- and
# network-bound, and two concurrent runs mostly compete for the same
# vendor rate limits. Raise only after watching real load.
#TRADINGAGENTS_API_WORKER_CONCURRENCY=1

# --- Data vendors (all optional — free/no-key vendors are tried first) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
FINNHUB_API_KEY=

# --- API service (api/settings.py, env_prefix=TRADINGAGENTS_API_) --------
# Signs and verifies the JWT NextAuth issues. Required — pydantic-settings
# raises at boot if this is unset or under 32 chars, so a missing/blank
# secret fails closed at startup rather than open on the first request.
# Generate one with:
#   openssl rand -base64 32
# Must be IDENTICAL to web/app/.env.production's NEXTAUTH_SECRET — this is
# one shared value, not a keypair; the frontend signs, the backend verifies.
TRADINGAGENTS_API_JWT_SECRET=

# CORS allowlist. pydantic-settings parses a list[str] field from a JSON
# array string (confirmed directly against this Settings class) — NOT
# comma-separated. Must be your real public origin(s); a bare "*" is
# rejected at startup (POST /auth/register and /auth/login have real side
# effects — see api/settings.py's _reject_wildcard_origin).
TRADINGAGENTS_API_ALLOWED_ORIGINS=["https://REPLACE-WITH-YOUR-DOMAIN"]

# Sane defaults from api/settings.py — 10 runs/IP/day, 500/day globally.
# Uncomment only if you deliberately want different limits; do NOT set
# either of these to a very large number for a public deployment (every
# run spends real LLM money — see api/settings.py's Cost controls comment).
#TRADINGAGENTS_API_MAX_RUNS_PER_IP_PER_DAY=10
#TRADINGAGENTS_API_MAX_RUNS_GLOBAL_PER_DAY=500

# RFC 8292 VAPID "sub" claim for push notifications — a contact URI, only
# checked for format (mailto: or https://), never verified as deliverable.
# Change this to a real address before this serves anyone but you.
TRADINGAGENTS_API_VAPID_SUBJECT=mailto:REPLACE-WITH-YOUR-EMAIL
