# Server-side (RSC, route handlers) base URL for the FastAPI backend.
API_BASE_URL=http://127.0.0.1:8000
# Client-side (browser) base URL — must be duplicated because Next.js only
# inlines NEXT_PUBLIC_ vars, and RSC fetches run in Node, not the browser.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Auth (Phase 1) -----------------------------------------------------
# Next.js only loads env files from this directory (web/app/), never the
# repo root -- these are ALSO listed in the repo-root .env.example for the
# backend's own reference, but process.env.NEXTAUTH_SECRET etc. inside
# web/app resolve from THIS file (as .env.local), not that one.
#
# Google OAuth app credentials (console.cloud.google.com -> Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be IDENTICAL to the backend's TRADINGAGENTS_API_JWT_SECRET (repo-root
# .env) -- one shared secret signs the token here and verifies it there.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
