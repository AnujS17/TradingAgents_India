# Frontend secrets for the Docker Compose deployment (web service — see
# docker-compose.yml). Copy to web/app/.env.production on the VM and fill
# it in; that exact path is what docker-compose.yml's web service
# `env_file:` entry points at.
#
# Unlike the repo-root .env.production, nothing here needs
# --env-file/interpolation tricks: docker-compose.yml passes this file
# straight through via `env_file:` on the web service, with no ${VAR}
# substitution happening inside it.

# Server-side only (RSC, and the SSE proxy route handler at
# src/app/api/runs/[runId]/stream/route.ts) — the in-network Docker
# service name, not the public URL, since this call never leaves the
# compose network. Already set as a runtime `environment:` value in
# docker-compose.yml's web service — repeated here only so this file
# matches web/app/.env.local.example's shape; docker-compose.yml's value
# wins if both are present.
API_BASE_URL=http://api:8000

# Public URL the BROWSER calls directly for every other API request.
# Must be IDENTICAL to the repo-root .env.production's
# NEXT_PUBLIC_API_BASE_URL (https://<your-domain>/backend) — but note
# that value only takes effect via docker-compose.yml's build.args, which
# is read from the repo-root env file, not this one. This line exists so
# `npm run build` run directly in this directory (outside Docker, e.g.
# for a one-off local check) picks up the same value.
NEXT_PUBLIC_API_BASE_URL=https://REPLACE-WITH-YOUR-DOMAIN/backend

# --- Auth ------------------------------------------------------------------
# Google OAuth app credentials (console.cloud.google.com -> APIs & Services
# -> Credentials -> OAuth 2.0 Client IDs). Create a PRODUCTION OAuth client
# separate from any dev one — its Authorized redirect URI must be:
#   https://<your-domain>/api/auth/callback/google
# (NextAuth's own route; not the /backend/* path Caddy gives the FastAPI
# service — see Caddyfile's comment on why the two prefixes stay separate.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must be IDENTICAL to the repo-root .env.production's
# TRADINGAGENTS_API_JWT_SECRET — one shared secret signs the token here
# and verifies it on the backend, not a keypair.
NEXTAUTH_SECRET=

# The real public URL NextAuth uses to build callback/redirect links.
# Must match DOMAIN in the repo-root .env.production, with the scheme.
NEXTAUTH_URL=https://REPLACE-WITH-YOUR-DOMAIN
